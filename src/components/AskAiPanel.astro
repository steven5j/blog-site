---
/**
 * Site-wide Ask AI drawer. Calls POST /api/ask (Cloudflare AI Search).
 * Mount once from Header; opens via [data-ask-open].
 */
const suggestions = [
  '這個網站的作者是誰？專長是什麼？',
  '有哪些作品或證照可以看？',
  '送報件系統升級專案做了什麼？',
];
---

<div
  id="ask-ai-panel"
  class="ask-ai-panel pointer-events-none fixed inset-0 z-[60] hidden"
  data-ask-panel
  hidden
  aria-hidden="true"
>
  <aside
    class="ask-ai-drawer pointer-events-auto absolute inset-y-0 right-0 flex w-full max-w-md flex-col border-l border-white/10 bg-ink text-white shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ask-ai-title"
    tabindex="-1"
    data-ask-drawer
  >
    <header
      class="flex items-start justify-between gap-4 border-b border-white/10 px-5 py-4"
      data-ask-header
    >
      <div class="flex items-center gap-3">
        <span class="ask-ai-avatar" aria-hidden="true">玄</span>
        <div>
          <p class="text-[0.65rem] font-semibold tracking-[0.28em] text-brand uppercase">
            Steven玄
          </p>
          <h2 id="ask-ai-title" class="font-display mt-0.5 text-xl font-semibold tracking-tight">
            Ask AI
          </h2>
          <p class="mt-0.5 text-sm text-white/55">依站內文章與作品回答</p>
        </div>
      </div>
      <button
        type="button"
        class="cursor-pointer border-0 bg-transparent px-1 py-1 text-sm tracking-[0.12em] text-white/70 uppercase transition hover:text-white"
        data-ask-close
      >
        關閉
      </button>
    </header>

    <div
      class="ask-ai-messages flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto px-4 py-5"
      data-ask-messages
      aria-live="polite"
    >
      <div class="ask-ai-empty space-y-4" data-ask-empty>
        <p class="text-sm leading-relaxed text-white/65">
          直接問站上的專案、文章，或關於這個網站的問題。
        </p>
        <ul class="flex flex-col items-start gap-2">
          {
            suggestions.map((text) => (
              <li>
                <button
                  type="button"
                  class="ask-ai-chip cursor-pointer border-0 text-left"
                  data-ask-suggestion
                  data-query={text}
                >
                  {text}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <form class="border-t border-white/10 px-4 py-3" data-ask-form>
      <label class="sr-only" for="ask-ai-input">向站內 AI 提問</label>
      <div class="ask-ai-composer">
        <textarea
          id="ask-ai-input"
          name="query"
          rows="1"
          maxlength="1000"
          required
          placeholder="傳一句話給 Ask AI…"
          class="ask-ai-input"
          data-ask-input
        ></textarea>
        <button
          type="submit"
          class="ask-ai-send"
          data-ask-submit
          aria-label="送出"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <path
              d="M5 12h12M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
      </div>
      <p class="mt-2 min-h-[1rem] text-[0.7rem] text-white/40" data-ask-status></p>
    </form>
  </aside>
</div>

<style is:global>
  /* Dynamic JS bubbles are not tagged with Astro scoped attrs, so styles
     must be global. Keep them under #ask-ai-panel to avoid leaking. */
  #ask-ai-panel[hidden] {
    display: none;
  }

  #ask-ai-panel .ask-ai-drawer {
    overflow: hidden;
    transform: translateX(100%);
    transition: transform 0.45s var(--ease-out-expo);
  }

  #ask-ai-panel.is-open .ask-ai-drawer {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #ask-ai-panel .ask-ai-drawer,
    #ask-ai-panel .ask-ai-row,
    #ask-ai-panel .ask-ai-typing span {
      animation: none;
      transition: none;
    }
  }

  #ask-ai-panel .ask-ai-messages {
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  #ask-ai-panel .ask-ai-avatar {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  #ask-ai-panel .ask-ai-chip {
    max-width: 100%;
    border-radius: 1rem 1rem 1rem 0.25rem;
    background: rgb(255 255 255 / 0.08);
    padding: 0.65rem 0.9rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.88);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  #ask-ai-panel .ask-ai-chip:hover {
    background: rgb(193 59 59 / 0.22);
    color: #fff;
  }

  #ask-ai-panel .ask-ai-row {
    display: flex;
    gap: 0.55rem;
    max-width: 92%;
    animation: ask-in 0.28s var(--ease-out-expo);
  }

  #ask-ai-panel .ask-ai-row-user {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  #ask-ai-panel .ask-ai-row-assistant,
  #ask-ai-panel .ask-ai-row-error {
    align-self: flex-start;
  }

  #ask-ai-panel .ask-ai-row-error .ask-ai-avatar {
    background: #5a2a2a;
  }

  #ask-ai-panel .ask-ai-col {
    min-width: 0;
  }

  #ask-ai-panel .ask-ai-meta {
    margin: 0 0 0.25rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
  }

  #ask-ai-panel .ask-ai-row-user .ask-ai-meta {
    text-align: right;
  }

  #ask-ai-panel .ask-ai-bubble {
    max-width: 100%;
    padding: 0.7rem 0.95rem;
    font-size: 0.9rem;
    line-height: 1.6;
    word-break: break-word;
  }

  #ask-ai-panel .ask-ai-bubble p {
    margin: 0;
  }

  #ask-ai-panel .ask-ai-bubble p + p,
  #ask-ai-panel .ask-ai-bubble ul + p,
  #ask-ai-panel .ask-ai-bubble ol + p,
  #ask-ai-panel .ask-ai-bubble p + ul,
  #ask-ai-panel .ask-ai-bubble p + ol {
    margin-top: 0.45rem;
  }

  #ask-ai-panel .ask-ai-bubble ul,
  #ask-ai-panel .ask-ai-bubble ol {
    margin: 0.35rem 0 0;
    padding-left: 1.15rem;
  }

  #ask-ai-panel .ask-ai-bubble li + li {
    margin-top: 0.2rem;
  }

  #ask-ai-panel .ask-ai-bubble code {
    font-size: 0.82em;
    border-radius: 0.2rem;
    background: rgb(0 0 0 / 0.25);
    padding: 0.05em 0.3em;
  }

  #ask-ai-panel .ask-ai-bubble-user {
    background: var(--color-brand);
    color: #fff;
    border-radius: 1rem 1rem 0.2rem 1rem;
    white-space: pre-wrap;
  }

  #ask-ai-panel .ask-ai-bubble-assistant {
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.08);
    color: rgb(255 255 255 / 0.92);
    border-radius: 1rem 1rem 1rem 0.2rem;
  }

  #ask-ai-panel .ask-ai-bubble-error {
    background: rgb(193 59 59 / 0.12);
    border: 1px solid rgb(193 59 59 / 0.35);
    color: rgb(255 210 210);
    border-radius: 1rem 1rem 1rem 0.2rem;
  }

  #ask-ai-panel .ask-ai-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.45rem;
  }

  #ask-ai-panel .ask-ai-sources a,
  #ask-ai-panel .ask-ai-sources span {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(255 255 255 / 0.05);
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    color: rgb(255 255 255 / 0.72);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #ask-ai-panel .ask-ai-sources a:hover {
    border-color: var(--color-brand);
    color: #fff;
  }

  #ask-ai-panel .ask-ai-typing {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    min-height: 1.15rem;
  }

  #ask-ai-panel .ask-ai-typing span {
    display: inline-block;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.45);
    animation: ask-dot 1s infinite ease-in-out;
  }

  #ask-ai-panel .ask-ai-typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  #ask-ai-panel .ask-ai-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  #ask-ai-panel .ask-ai-composer {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 1.35rem;
    background: var(--color-ink-elevated);
    padding: 0.35rem 0.35rem 0.35rem 0.9rem;
  }

  #ask-ai-panel .ask-ai-input {
    max-height: 7rem;
    min-height: 2.4rem;
    flex: 1;
    resize: none;
    border: 0;
    background: transparent;
    padding: 0.55rem 0;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.45;
    color: #fff;
  }

  #ask-ai-panel .ask-ai-input::placeholder {
    color: rgb(255 255 255 / 0.35);
  }

  #ask-ai-panel .ask-ai-input:focus {
    outline: none;
  }

  #ask-ai-panel .ask-ai-send {
    display: inline-flex;
    height: 2.4rem;
    width: 2.4rem;
    flex-shrink: 0;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    transition: background 0.2s ease;
  }

  #ask-ai-panel .ask-ai-send:hover {
    background: var(--color-brand-hover);
  }

  #ask-ai-panel .ask-ai-send:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  #ask-ai-panel .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes ask-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes ask-dot {
    0%,
    80%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }
</style>

<script>
  type AskSource = {
    id?: string;
    score?: number;
    text?: string;
    key?: string | null;
    metadata?: Record<string, unknown> | null;
  };

  type AskJsonResponse = {
    answer?: string;
    sources?: AskSource[];
    error?: string;
  };

  function escapeHtml(text: string) {
    return text
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function inlineFormat(text: string) {
    return escapeHtml(text)
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/`([^`]+)`/g, '<code>$1</code>');
  }

  function formatMessageHtml(text: string) {
    const lines = text.replace(/\r/g, '').split('\n');
    const out: string[] = [];
    let list: 'ul' | 'ol' | null = null;

    const closeList = () => {
      if (list) {
        out.push(`</${list}>`);
        list = null;
      }
    };

    for (const line of lines) {
      const ul = line.match(/^\s*[\*\-•]\s+(.+)$/);
      const ol = line.match(/^\s*\d+[.)]\s+(.+)$/);
      if (ul) {
        if (list !== 'ul') {
          closeList();
          out.push('<ul>');
          list = 'ul';
        }
        out.push(`<li>${inlineFormat(ul[1])}</li>`);
        continue;
      }
      if (ol) {
        if (list !== 'ol') {
          closeList();
          out.push('<ol>');
          list = 'ol';
        }
        out.push(`<li>${inlineFormat(ol[1])}</li>`);
        continue;
      }
      closeList();
      if (!line.trim()) continue;
      out.push(`<p>${inlineFormat(line)}</p>`);
    }
    closeList();
    return out.join('') || `<p>${inlineFormat(text)}</p>`;
  }

  function peelSourcesFromAnswer(text: string): { body: string; paths: string[] } {
    const paths: string[] = [];
    const body = text
      .replace(/(?:^|\n)來源[:：]\s*(.+)\s*$/gm, (_, raw: string) => {
        for (const part of raw.split(/[、,，\s]+/)) {
          const trimmed = part.trim().replace(/[。．.]+$/, '');
          if (trimmed.startsWith('/')) paths.push(trimmed);
        }
        return '';
      })
      .trim();
    return { body, paths };
  }

  function sourceHref(source: AskSource): string | null {
    const meta = source.metadata;
    if (meta && typeof meta.url === 'string' && meta.url.startsWith('/')) {
      return meta.url;
    }
    const key = source.key;
    if (!key) return null;
    if (key.startsWith('http://') || key.startsWith('https://') || key.startsWith('/')) {
      return key;
    }
    return null;
  }

  function sourceLabel(source: AskSource): string {
    const meta = source.metadata;
    if (meta && typeof meta.title === 'string' && meta.title.trim()) return meta.title;
    if (source.key) return source.key.replace(/^https?:\/\/stevenjhu\.com/, '');
    return '相關片段';
  }

  function renderSources(sources: AskSource[], extraPaths: string[] = []): string {
    const chips: string[] = [];
    const seen = new Set<string>();

    for (const source of sources.slice(0, 5)) {
      const href = sourceHref(source);
      const label = sourceLabel(source);
      const key = href ?? label;
      if (seen.has(key)) continue;
      seen.add(key);
      if (href) {
        chips.push(
          `<a href="${escapeHtml(href)}" data-astro-prefetch>${escapeHtml(label)}</a>`,
        );
      } else {
        chips.push(`<span>${escapeHtml(label)}</span>`);
      }
    }

    for (const path of extraPaths) {
      if (seen.has(path)) continue;
      seen.add(path);
      chips.push(`<a href="${escapeHtml(path)}" data-astro-prefetch>${escapeHtml(path)}</a>`);
    }

    if (!chips.length) return '';
    return `<div class="ask-ai-sources">${chips.join('')}</div>`;
  }

  function friendlyError(raw: string): string {
    if (raw.includes('404')) return '暫時連不上 Ask AI，請稍後再試。';
    if (raw.includes('429')) return '提問太頻繁，請稍候再問。';
    if (raw.includes('502') || raw.includes('503')) return 'AI 服務忙碌中，請稍後再試。';
    if (raw.includes('binding is not configured')) return 'Ask AI 尚未設定完成。';
    return '目前無法回答，請稍後再試。';
  }

  const typingHtml =
    '<div class="ask-ai-typing" aria-label="正在輸入"><span></span><span></span><span></span></div>';

  async function readAskStream(
    response: Response,
    onDelta: (text: string) => void,
    onChunks: (chunks: AskSource[]) => void,
  ) {
    const reader = response.body?.getReader();
    if (!reader) throw new Error('無法讀取串流回應');

    const decoder = new TextDecoder();
    let buffer = '';
    let eventName = 'message';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n');
      buffer = lines.pop() ?? '';

      for (const rawLine of lines) {
        const line = rawLine.replace(/\r$/, '');
        if (!line) {
          eventName = 'message';
          continue;
        }
        if (line.startsWith('event:')) {
          eventName = line.slice(6).trim();
          continue;
        }
        if (!line.startsWith('data:')) continue;

        const data = line.slice(5).trim();
        if (data === '[DONE]') {
          eventName = 'message';
          continue;
        }

        try {
          const parsed = JSON.parse(data) as
            | AskSource[]
            | {
                response?: string;
                choices?: Array<{ delta?: { content?: string } }>;
              };
          if (eventName === 'chunks' && Array.isArray(parsed)) {
            onChunks(parsed as AskSource[]);
          } else if (parsed && !Array.isArray(parsed)) {
            const delta =
              parsed.choices?.[0]?.delta?.content ??
              (typeof parsed.response === 'string' ? parsed.response : '');
            if (delta) onDelta(delta);
          }
        } catch {
          // ignore malformed SSE chunks
        }
      }
    }
  }

  function bindAskAi() {
    const panel = document.querySelector<HTMLElement>('[data-ask-panel]');
    const drawer = document.querySelector<HTMLElement>('[data-ask-drawer]');
    const form = document.querySelector<HTMLFormElement>('[data-ask-form]');
    const input = document.querySelector<HTMLTextAreaElement>('[data-ask-input]');
    const submit = document.querySelector<HTMLButtonElement>('[data-ask-submit]');
    const messages = document.querySelector<HTMLElement>('[data-ask-messages]');
    const empty = document.querySelector<HTMLElement>('[data-ask-empty]');
    const status = document.querySelector<HTMLElement>('[data-ask-status]');
    if (!panel || !drawer || !form || !input || !submit || !messages || !status) return;

    let busy = false;
    let lastFocus: HTMLElement | null = null;
    const mqMobile = window.matchMedia('(max-width: 767px)');

    const setStatus = (text: string) => {
      status.textContent = text;
    };

    const resizeInput = () => {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 112)}px`;
    };

    const menuIsOpen = () => {
      const menuPanel = document.querySelector<HTMLElement>('[data-menu-panel]');
      return Boolean(menuPanel && !menuPanel.hidden);
    };

    const lockPageIfMobile = () => {
      if (mqMobile.matches) document.body.style.overflow = 'hidden';
      else if (!menuIsOpen()) document.body.style.overflow = '';
    };

    const unlockPageIfSafe = () => {
      if (!menuIsOpen()) document.body.style.overflow = '';
    };

    const isAskOpen = () => !panel.hidden && panel.classList.contains('is-open');

    const onPointerDownOutside = (e: PointerEvent) => {
      if (!isAskOpen()) return;
      const target = e.target;
      if (!(target instanceof Node)) return;
      if (drawer.contains(target)) return;
      if (target instanceof Element && target.closest('[data-ask-open]')) return;
      close();
    };

    const open = () => {
      lastFocus = document.activeElement as HTMLElement | null;
      panel.hidden = false;
      panel.classList.remove('hidden');
      panel.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => panel.classList.add('is-open'));
      lockPageIfMobile();
      document.querySelectorAll<HTMLButtonElement>('[data-ask-open]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'true');
      });
      input.focus();
    };

    const close = () => {
      panel.classList.remove('is-open');
      document.querySelectorAll<HTMLButtonElement>('[data-ask-open]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
      });
      const finish = () => {
        panel.hidden = true;
        panel.classList.add('hidden');
        panel.setAttribute('aria-hidden', 'true');
        unlockPageIfSafe();
        lastFocus?.focus?.();
      };
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) finish();
      else window.setTimeout(finish, 400);
    };

    mqMobile.onchange = () => {
      if (!isAskOpen()) return;
      lockPageIfMobile();
    };

    messages.onwheel = (e) => {
      e.stopPropagation();
    };

    const outsideKey = '__askAiOutsideAbort' as const;
    const prevAbort = (document as Document & { [outsideKey]?: AbortController })[outsideKey];
    prevAbort?.abort();
    const outsideAbort = new AbortController();
    (document as Document & { [outsideKey]?: AbortController })[outsideKey] = outsideAbort;
    document.addEventListener('pointerdown', onPointerDownOutside, {
      capture: true,
      signal: outsideAbort.signal,
    });

    const hideEmpty = () => {
      empty?.classList.add('hidden');
    };

    const appendMessage = (role: 'user' | 'assistant' | 'error', html: string) => {
      hideEmpty();
      const row = document.createElement('div');
      row.className = `ask-ai-row ask-ai-row-${role === 'error' ? 'error' : role}`;

      const col = document.createElement('div');
      col.className = 'ask-ai-col';

      const meta = document.createElement('p');
      meta.className = 'ask-ai-meta';
      meta.textContent = role === 'user' ? '你' : role === 'error' ? '系統' : 'Steven玄 AI';

      const bubble = document.createElement('div');
      bubble.className = `ask-ai-bubble ask-ai-bubble-${role}`;
      bubble.innerHTML = html;

      if (role !== 'user') {
        const avatar = document.createElement('span');
        avatar.className = 'ask-ai-avatar';
        avatar.setAttribute('aria-hidden', 'true');
        avatar.textContent = role === 'error' ? '!' : '玄';
        row.appendChild(avatar);
      }

      col.appendChild(meta);
      col.appendChild(bubble);
      row.appendChild(col);
      messages.appendChild(row);
      messages.scrollTop = messages.scrollHeight;
      return { row, bubble, col };
    };

    const paintAnswer = (
      col: HTMLElement,
      bubble: HTMLElement,
      raw: string,
      sources: AskSource[],
    ) => {
      const { body, paths } = peelSourcesFromAnswer(raw.trim() || '站內暫時找不到足夠相關的內容。');
      bubble.className = 'ask-ai-bubble ask-ai-bubble-assistant';
      bubble.innerHTML = formatMessageHtml(body);
      col.querySelector('.ask-ai-sources')?.remove();
      const chips = renderSources(sources, paths);
      if (chips) col.insertAdjacentHTML('beforeend', chips);
    };

    const ask = async (query: string) => {
      const q = query.trim();
      if (!q || busy) return;
      busy = true;
      submit.disabled = true;
      setStatus('搜尋站內內容中…');

      appendMessage('user', escapeHtml(q));
      const { row, bubble, col } = appendMessage('assistant', typingHtml);
      let answer = '';
      let sources: AskSource[] = [];

      try {
        const res = await fetch('/api/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: q, stream: false }),
        });

        const contentType = res.headers.get('content-type') ?? '';

        if (!res.ok) {
          let errMsg = `請求失敗（${res.status}）`;
          try {
            const errBody = (await res.json()) as AskJsonResponse;
            if (errBody.error) errMsg = errBody.error;
          } catch {
            // keep status text
          }
          throw new Error(errMsg);
        }

        if (contentType.includes('text/event-stream')) {
          await readAskStream(
            res,
            (delta) => {
              answer += delta;
              bubble.style.whiteSpace = 'pre-wrap';
              bubble.textContent = answer;
              messages.scrollTop = messages.scrollHeight;
              setStatus('產生回覆中…');
            },
            (chunks) => {
              sources = chunks.map((chunk) => {
                const raw = chunk as AskSource & {
                  item?: { key?: string; metadata?: Record<string, unknown> };
                };
                return {
                  id: raw.id,
                  score: raw.score,
                  text: raw.text,
                  key: raw.key ?? raw.item?.key ?? null,
                  metadata: raw.metadata ?? raw.item?.metadata ?? null,
                };
              });
            },
          );
        } else {
          const data = (await res.json()) as AskJsonResponse;
          if (data.error) throw new Error(data.error);
          answer = data.answer ?? '';
          sources = data.sources ?? [];
        }

        paintAnswer(col, bubble, answer, sources);
        setStatus('');
      } catch (err) {
        const raw = err instanceof Error ? err.message : '發生未知錯誤';
        row.className = 'ask-ai-row ask-ai-row-error';
        const avatar = row.querySelector('.ask-ai-avatar');
        if (avatar) avatar.textContent = '!';
        const meta = row.querySelector('.ask-ai-meta');
        if (meta) meta.textContent = '系統';
        bubble.className = 'ask-ai-bubble ask-ai-bubble-error';
        bubble.textContent = friendlyError(raw);
        setStatus('');
      } finally {
        busy = false;
        submit.disabled = false;
        messages.scrollTop = messages.scrollHeight;
      }
    };

    document.querySelectorAll<HTMLButtonElement>('[data-ask-open]').forEach((btn) => {
      btn.onclick = () => {
        const menuPanel = document.querySelector<HTMLElement>('[data-menu-panel]');
        if (menuPanel && !menuPanel.hidden) {
          menuPanel.querySelector<HTMLButtonElement>('[data-menu-close]')?.click();
        }
        open();
      };
    });

    panel.onclick = (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      if (target.closest('[data-ask-close]')) {
        close();
        return;
      }
      const suggestion = target.closest<HTMLButtonElement>('[data-ask-suggestion]');
      if (suggestion) {
        const q = suggestion.dataset.query ?? suggestion.textContent ?? '';
        input.value = '';
        resizeInput();
        void ask(q);
      }
    };

    form.onsubmit = (e) => {
      e.preventDefault();
      const q = input.value;
      input.value = '';
      resizeInput();
      void ask(q);
    };

    input.oninput = resizeInput;

    input.onkeydown = (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    };

    panel.onkeydown = (e) => {
      if (e.key === 'Escape') close();
    };
  }

  bindAskAi();
  document.addEventListener('astro:page-load', bindAskAi);
</script>
