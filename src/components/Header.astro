---
import AskAiPanel from './AskAiPanel.astro';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const pathname = Astro.url.pathname;

/** Primary nav — same links on desktop & mobile */
const primaryLinks = [
  { href: '/', label: '首頁', match: 'exact' as const },
  {
    href: '/blog',
    label: '文章',
    match: 'blog' as const,
    children: [
      { href: '/topics/software', label: '軟體工程筆記' },
      { href: '/topics/business', label: '商業經驗' },
      { href: '/topics/life', label: '生活心得體驗分享' },
    ],
  },
  { href: '/projects', label: '作品', match: 'prefix' as const },
  { href: '/series', label: '系列', match: 'prefix' as const },
  { href: '/about', label: '關於', match: 'prefix' as const },
];

function isDatePermalink(path: string) {
  return /^\/\d{4}\/\d{2}\/\d{2}(\/|$)/.test(path);
}

function isActive(href: string, match: 'exact' | 'prefix' | 'blog') {
  if (match === 'exact') return pathname === '/' || pathname === '';
  if (match === 'blog') {
    return (
      pathname === '/blog' ||
      pathname.startsWith('/blog/') ||
      pathname.startsWith('/topics/') ||
      isDatePermalink(pathname)
    );
  }
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  class:list={[
    'site-header z-40 w-full',
    transparent
      ? 'absolute inset-x-0 top-0 bg-transparent'
      : 'relative bg-ink text-white',
  ]}
>
  <div
    class="mx-auto flex max-w-site items-center justify-between gap-4 px-5 py-4 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="inline-flex shrink-0 items-center no-underline transition hover:opacity-90"
      aria-label="Steven玄 首頁"
      data-astro-prefetch
    >
      <img
        src="/logo.png"
        alt="Steven玄"
        width="120"
        height="60"
        class="h-7 w-auto sm:h-8"
        decoding="async"
      />
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Desktop nav -->
      <nav class="hidden md:block" aria-label="主要導覽">
        <ul class="flex items-center gap-1 lg:gap-2">
          {
            primaryLinks.map((link) => (
              <li class="group relative">
                <a
                  href={link.href}
                  class:list={[
                    'inline-flex items-center gap-2 px-3 py-2 text-lg no-underline transition',
                    isActive(link.href, link.match)
                      ? 'text-brand'
                      : 'text-white/90 hover:text-brand',
                  ]}
                  aria-current={isActive(link.href, link.match) ? 'page' : undefined}
                  data-astro-prefetch
                >
                  {link.label}
                </a>
                {'children' in link && link.children && (
                  <ul
                    class="invisible absolute right-0 top-full z-50 min-w-[14rem] translate-y-1 border border-white/10 bg-ink py-2 opacity-0 shadow-lg transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
                  >
                    {link.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class="block whitespace-nowrap px-4 py-2.5 text-base text-white/80 no-underline transition hover:bg-white/5 hover:text-brand"
                          data-astro-prefetch
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        type="button"
        class="inline-flex cursor-pointer items-center border border-white/25 bg-transparent px-2.5 py-1.5 text-xs font-semibold tracking-[0.14em] text-white/90 uppercase transition hover:border-brand hover:text-brand"
        aria-expanded="false"
        aria-controls="ask-ai-panel"
        aria-haspopup="dialog"
        data-ask-open
      >
        Ask AI
      </button>

      <!-- Mobile only: hamburger -->
      <button
        type="button"
        class="menu-toggle inline-flex cursor-pointer items-center gap-2 border-0 bg-transparent p-1 text-sm uppercase tracking-[0.15em] text-white/90 md:hidden"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="開啟選單"
        data-menu-toggle
      >
        <span class="flex flex-col gap-1" aria-hidden="true">
          <span class="block h-0.5 w-5 bg-current"></span>
          <span class="block h-0.5 w-5 bg-current"></span>
          <span class="block h-0.5 w-5 bg-current"></span>
        </span>
        <span>選單</span>
      </button>
    </div>
  </div>

  <!-- Mobile overlay -->
  <nav
    id="site-menu"
    class="site-menu fixed inset-0 z-50 hidden bg-ink/95 text-white backdrop-blur-sm md:hidden"
    aria-label="手機導覽"
    data-menu-panel
    hidden
  >
    <div class="mx-auto flex h-full max-w-lg flex-col px-8 py-10">
      <div class="mb-10 flex items-center justify-between">
        <img
          src="/logo.png"
          alt="Steven玄"
          width="120"
          height="60"
          class="h-7 w-auto"
          decoding="async"
        />
        <button
          type="button"
          class="cursor-pointer border-0 bg-transparent text-sm uppercase tracking-[0.15em] text-white/80"
          data-menu-close
        >
          關閉
        </button>
      </div>
      <ul class="flex flex-col gap-1">
        {
          primaryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'block py-3 font-display text-2xl font-medium no-underline transition hover:text-brand',
                  isActive(link.href, link.match) ? 'text-brand' : 'text-white',
                ]}
                aria-current={isActive(link.href, link.match) ? 'page' : undefined}
                data-astro-prefetch
                data-menu-close
              >
                {link.label}
              </a>
              {'children' in link && link.children && (
                <ul class="mb-2 ml-1 border-l border-white/15 pl-4">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block py-2 text-sm text-white/70 no-underline transition hover:text-brand"
                        data-astro-prefetch
                        data-menu-close
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li class="mt-6 border-t border-white/15 pt-4">
          <button
            type="button"
            class="block w-full cursor-pointer border-0 bg-transparent py-3 text-left font-display text-2xl font-medium text-brand transition hover:text-white"
            aria-expanded="false"
            aria-controls="ask-ai-panel"
            data-ask-open
          >
            Ask AI
          </button>
        </li>
      </ul>
    </div>
  </nav>

  <AskAiPanel />
</header>

<script>
  function bindMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    if (!toggle || !panel) return;

    const open = () => {
      panel.hidden = false;
      panel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      panel.hidden = true;
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    toggle.onclick = () => {
      if (panel.hidden) open();
      else close();
    };
    panel.querySelectorAll('[data-menu-close]').forEach((el) => {
      el.addEventListener('click', close);
    });
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    const mq = window.matchMedia('(min-width: 768px)');
    const onMq = () => {
      if (mq.matches) close();
    };
    mq.addEventListener('change', onMq);
  }

  bindMenu();
  document.addEventListener('astro:page-load', bindMenu);
</script>
