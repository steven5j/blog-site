---
import { SITE, websiteJsonLd, personJsonLd, type JsonLd } from '@/utils/seo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  type?: 'website' | 'article';
  jsonLd?: JsonLd[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = '/og-default.svg',
  canonical,
  type = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonicalUrl = canonical
  ? new URL(canonical, SITE.url).toString()
  : new URL(Astro.url.pathname, SITE.url).toString();
const imageUrl = new URL(ogImage, SITE.url).toString();

const schemas: JsonLd[] = [websiteJsonLd(), personJsonLd(), ...jsonLd];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="zh_TW" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
