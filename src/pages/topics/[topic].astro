---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/Reveal.astro';
import PostList from '@/components/PostList.astro';
import {
  isTopic,
  TOPIC_DESCRIPTIONS,
  TOPIC_LABELS,
  TOPICS,
} from '@/utils/permalinks';

export function getStaticPaths() {
  return TOPICS.map((topic) => ({ params: { topic } }));
}

const { topic: topicParam } = Astro.params;
if (!topicParam || !isTopic(topicParam)) {
  return Astro.redirect('/blog');
}
const topic = topicParam;

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.topic === topic)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const seriesList = (await getCollection('series'))
  .filter((s) => s.data.topic === topic)
  .sort((a, b) => a.data.order - b.data.order);

const realEstatePosts = posts.filter((p) => p.data.series === 'real-estate');
const industryPosts = posts.filter((p) => p.data.series === 'industry');
const fintechPosts = posts.filter((p) => p.data.series === 'fintech');
const careerPosts = posts.filter((p) => p.data.series === 'career');
const ungroupedBusinessPosts = posts.filter(
  (p) =>
    !p.data.series ||
    !['real-estate', 'industry', 'fintech', 'career'].includes(p.data.series),
);

const businessHero = {
  eyebrow: '商 業 · 產 業 · 資 產',
  title: '商業經驗',
  body: '各產業經銷、代理、顧問與現場經營的經驗筆記；亦含投資理財、職涯與房地產。下方依分類瀏覽，或點錨點直接跳到對應區塊。',
  image: '/images/wp/business-hero.jpg',
} as const;

const businessNav = [
  { href: '#industry', label: '產業實務' },
  { href: '#fintech', label: '投資／金融科技' },
  { href: '#career', label: '職涯與成長' },
  { href: '#real-estate', label: '房地產' },
] as const;

const businessGroups = [
  {
    id: 'industry',
    title: '產業實務',
    description: '保險產品、餐飲經營、政府標案等現場經驗。',
    posts: industryPosts,
    seriesHref: '/series/industry',
    previewLimit: 5,
  },
  {
    id: 'fintech',
    title: '投資與金融科技',
    description: 'FinTech、債權理財與區塊鏈等投資觀察。',
    posts: fintechPosts,
    seriesHref: '/series/fintech',
    previewLimit: 5,
  },
  {
    id: 'career',
    title: '職涯與成長',
    description: '面試、專案管理與個人品牌相關心得。',
    posts: careerPosts,
    seriesHref: '/series/career',
    previewLimit: 5,
  },
  {
    id: 'real-estate',
    title: '房地產',
    description: '收租屋操作、區域評估與看房流程。',
    posts: realEstatePosts,
    seriesHref: '/series/real-estate',
    previewLimit: 5,
  },
] as const;

const lifePanel = {
  eyebrow: '生 活 日 記',
  title: '生活心得體驗分享',
  body: '從高中畢業後，當時為了讓自己的未來更有前瞻性，開始認真的參與很多的聚會活動，還有參加社團，認識新朋友並學習成長，分享學習筆記，分享體驗生活。',
  image: '/images/wp/life-hero.jpg',
} as const;

const softwareHero = {
  eyebrow: '軟 體 工 程',
  title: '軟體工程筆記',
  body: '從 2019 年踏入程式與軟體科技產業以來的筆記與發展紀錄。作品集請至作品頁；主題合集請至系列頁；下方為本主題文章清單。',
  image: '/images/wp/architecture.jpg',
} as const;

const softwareHubLinks = [
  {
    title: '作品',
    description: '專案成就、Side Project 與證照。',
    href: '/projects',
    cta: '查看作品 →',
  },
  {
    title: '系列',
    description: '前端、後端、資料庫與工具的主題合集。',
    href: '/series',
    cta: '瀏覽系列 →',
  },
  {
    title: '文章',
    description: '本主題全部筆記，依時間排列。',
    href: '#software-posts',
    cta: '往下看文章 →',
  },
] as const;

const softwareSeriesCovers: Record<string, string> = {
  javascript: '/images/wp/javascript.jpg',
  react: '/images/wp/react.jpg',
  frontend: '/images/wp/frontend.jpg',
  csharp: '/images/wp/csharp.jpg',
  sql: '/images/wp/rdbms.jpg',
  android: '/images/wp/android.jpg',
  mis: '/images/wp/mis.jpg',
  architecture: '/images/wp/architecture.jpg',
  python: '/images/wp/study-notes.jpg',
  portfolio: '/images/wp/project.jpg',
};
---

<BaseLayout
  title={TOPIC_LABELS[topic]}
  description={TOPIC_DESCRIPTIONS[topic]}
>
  {
    topic === 'software' ? (
      <>
        <section
          class="relative flex min-h-[480px] items-center bg-cover bg-center text-white"
          style={`background-image: linear-gradient(rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.55)), url('${softwareHero.image}')`}
        >
          <div class="relative z-10 mx-auto w-full max-w-site px-5 py-16 sm:px-6 lg:px-8">
            <div class="max-w-3xl" data-reveal>
              <p class="text-sm font-semibold tracking-[0.35em] text-brand sm:text-base">
                {softwareHero.eyebrow}
              </p>
              <h1 class="font-display mt-4 text-3xl font-bold tracking-tight text-white sm:text-5xl">
                {softwareHero.title}
              </h1>
              <p class="mt-6 text-base leading-relaxed text-white/85 sm:text-lg">
                {softwareHero.body}
              </p>
            </div>
          </div>
        </section>

        <section class="bg-paper-elevated">
          <div class="mx-auto max-w-site px-5 py-14 sm:px-6 sm:py-16 lg:px-8">
            <Reveal>
              <p class="text-xs font-semibold tracking-[0.3em] text-brand uppercase">
                導覽
              </p>
              <h2 class="font-display mt-3 text-2xl font-bold text-ink sm:text-3xl">
                三個入口
              </h2>
              <p class="mt-2 text-mist-muted">
                主題 Hub 負責指路：作品、系列與文章各走一條路。
              </p>
            </Reveal>

            <ul class="mt-10 grid gap-5 sm:grid-cols-3">
              {softwareHubLinks.map((link, i) => (
                <li>
                  <Reveal delay={i * 50}>
                    <a
                      href={link.href}
                      class="group flex h-full flex-col border border-line bg-paper p-6 no-underline transition hover:border-brand/40 hover:shadow-sm"
                    >
                      <h3 class="font-display text-xl font-semibold text-ink transition group-hover:text-brand">
                        {link.title}
                      </h3>
                      <p class="mt-2 flex-1 text-sm text-mist-muted">
                        {link.description}
                      </p>
                      <span class="mt-4 text-xs font-semibold tracking-wider text-brand uppercase">
                        {link.cta}
                      </span>
                    </a>
                  </Reveal>
                </li>
              ))}
            </ul>
          </div>
        </section>

        {seriesList.length > 0 && (
          <section class="border-t border-line bg-paper">
            <div class="mx-auto max-w-site px-5 py-14 sm:px-6 sm:py-16 lg:px-8">
              <Reveal>
                <div class="flex flex-wrap items-end justify-between gap-4">
                  <div>
                    <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
                      本主題系列
                    </h2>
                    <p class="mt-2 text-mist-muted">
                      精簡列表；完整封面與分組請至系列總覽。
                    </p>
                  </div>
                  <a
                    href="/series"
                    class="text-sm font-semibold text-brand no-underline hover:text-brand-hover"
                  >
                    全部系列 →
                  </a>
                </div>
              </Reveal>

              <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {seriesList.map((s, i) => (
                  <li>
                    <Reveal delay={i * 30}>
                      <a
                        href={`/series/${s.id}`}
                        class="flex gap-4 border border-line bg-paper-elevated p-4 no-underline transition hover:border-brand/40"
                      >
                        <div
                          class="h-16 w-24 shrink-0 bg-cover bg-center"
                          style={`background-image: url('${softwareSeriesCovers[s.id] || '/images/wp/study-notes.jpg'}')`}
                          aria-hidden="true"
                        />
                        <div class="min-w-0">
                          <span class="font-medium text-ink">{s.data.title}</span>
                          <span class="mt-1 block line-clamp-2 text-sm text-mist-muted">
                            {s.data.description}
                          </span>
                        </div>
                      </a>
                    </Reveal>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        <section id="software-posts" class="scroll-mt-20 bg-paper-elevated">
          <div class="mx-auto max-w-site px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
            <Reveal>
              <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
                軟體工程文章
              </h2>
              <p class="mt-2 text-mist-muted">
                架構、前後端、資料庫、DevOps 與學習筆記。
              </p>
            </Reveal>
            <div class="mt-10">
              <PostList posts={posts} empty="此主題尚無文章。" />
            </div>
          </div>
        </section>
      </>
    ) : topic === 'business' ? (
      <>
        <section
          class="relative flex min-h-[360px] items-center bg-cover bg-center text-white sm:min-h-[420px]"
          style={`background-image: linear-gradient(rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.55)), url('${businessHero.image}')`}
        >
          <div class="relative z-10 mx-auto w-full max-w-site px-5 py-14 sm:px-6 lg:px-8">
            <div class="max-w-3xl" data-reveal>
              <p class="text-sm font-semibold tracking-[0.35em] text-brand sm:text-base">
                {businessHero.eyebrow}
              </p>
              <h1 class="font-display mt-4 text-3xl font-bold tracking-tight text-white sm:text-5xl">
                {businessHero.title}
              </h1>
              <p class="mt-5 text-base leading-relaxed text-white/85 sm:text-lg">
                {businessHero.body}
              </p>
            </div>
          </div>
        </section>

        <section class="bg-paper-elevated">
          <div class="mx-auto max-w-site px-5 py-12 sm:px-6 sm:py-14 lg:px-8">
            <Reveal>
              <p class="text-xs font-semibold tracking-[0.3em] text-brand uppercase">
                目錄
              </p>
              <h2 class="font-display mt-3 text-2xl font-bold text-ink sm:text-3xl">
                依分類瀏覽
              </h2>
              <p class="mt-2 text-mist-muted">
                四個分類同級並列；點選即可跳到對應文章區塊。
              </p>
            </Reveal>
            <nav
              class="mt-8 flex flex-wrap gap-2"
              aria-label="商業文章分類"
            >
              {businessNav.map((item) => (
                <a
                  href={item.href}
                  class="border border-line bg-paper px-3 py-1.5 text-sm text-mist-muted no-underline transition hover:border-brand hover:text-brand"
                >
                  {item.label}
                </a>
              ))}
              {ungroupedBusinessPosts.length > 0 && (
                <a
                  href="#business-other"
                  class="border border-line bg-paper px-3 py-1.5 text-sm text-mist-muted no-underline transition hover:border-brand hover:text-brand"
                >
                  其他
                </a>
              )}
            </nav>
          </div>
        </section>

        <section id="business-posts" class="scroll-mt-20 bg-paper">
          <div class="mx-auto max-w-site px-5 py-14 sm:px-6 sm:py-16 lg:px-8">
            {businessGroups.map((group, gi) => (
              <div
                id={group.id}
                class:list={[
                  'scroll-mt-20',
                  gi > 0 ? 'mt-16 border-t border-line pt-14' : '',
                ]}
              >
                <Reveal>
                  <div class="flex flex-wrap items-end justify-between gap-4">
                    <div>
                      <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
                        {group.title}
                        <span class="ml-2 text-base font-normal text-mist-muted">
                          ({group.posts.length})
                        </span>
                      </h2>
                      <p class="mt-2 text-mist-muted">{group.description}</p>
                    </div>
                    <a
                      href={group.seriesHref}
                      class="text-sm font-semibold text-brand no-underline hover:text-brand-hover"
                    >
                      查看系列 →
                    </a>
                  </div>
                </Reveal>
                <div class="mt-8">
                  <PostList
                    posts={group.posts}
                    empty="此分類尚無文章。"
                    limit={group.previewLimit}
                  />
                </div>
                {group.posts.length > group.previewLimit && (
                  <Reveal class="mt-6">
                    <a
                      href={group.seriesHref}
                      class="inline-block border border-ink px-5 py-2 text-xs font-semibold tracking-[0.15em] text-ink no-underline uppercase transition hover:bg-ink hover:text-white"
                    >
                      看全部 {group.posts.length} 篇
                    </a>
                  </Reveal>
                )}
              </div>
            ))}

            {ungroupedBusinessPosts.length > 0 && (
              <div
                id="business-other"
                class="mt-16 scroll-mt-20 border-t border-line pt-14"
              >
                <Reveal>
                  <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
                    其他商業文章
                  </h2>
                  <p class="mt-2 text-mist-muted">尚未歸入子系列的商業筆記。</p>
                </Reveal>
                <div class="mt-8">
                  <PostList
                    posts={ungroupedBusinessPosts}
                    empty="此分類尚無文章。"
                  />
                </div>
              </div>
            )}
          </div>
        </section>
      </>
    ) : topic === 'life' ? (
      <>
        <section
          class="relative flex min-h-[550px] items-center bg-cover bg-center text-white"
          style={`background-image: linear-gradient(rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.55)), url('${lifePanel.image}')`}
        >
          <div class="relative z-10 mx-auto w-full max-w-site px-5 py-16 sm:px-6 lg:px-8">
            <div class="max-w-2xl" data-reveal>
              <p class="text-sm font-semibold tracking-[0.35em] text-brand sm:text-base">
                {lifePanel.eyebrow}
              </p>
              <h1 class="font-display mt-4 text-3xl font-bold tracking-tight text-white sm:text-5xl">
                {lifePanel.title}
              </h1>
              <p class="mt-6 text-base leading-relaxed text-white/85 sm:text-lg">
                {lifePanel.body}
              </p>
            </div>
          </div>
        </section>

        <section id="life-posts" class="scroll-mt-20 bg-paper-elevated">
          <div class="mx-auto max-w-site px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
            <Reveal>
              <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
                生活心得文章
              </h2>
              <p class="mt-2 text-mist-muted">聚會、社團、學習與生活體驗分享。</p>
            </Reveal>
            <div class="mt-10">
              <PostList posts={posts} empty="此主題尚無文章。" />
            </div>
          </div>
        </section>
      </>
    ) : (
      <>
        <div class="page-banner">
          <div class="mx-auto w-full max-w-site px-5 py-14 sm:px-6 lg:px-8">
            <p class="text-xs tracking-[0.25em] text-white/60 uppercase">主題</p>
            <h1 class="font-display mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
              {TOPIC_LABELS[topic]}
            </h1>
            <p class="mt-3 max-w-2xl text-white/75">
              {TOPIC_DESCRIPTIONS[topic]}
            </p>
          </div>
        </div>

        <section class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
          {seriesList.length > 0 && (
            <div class="mb-14">
              <Reveal>
                <h2 class="font-display text-xl font-semibold text-ink">
                  相關系列
                </h2>
              </Reveal>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {seriesList.map((s, i) => (
                  <li>
                    <Reveal delay={i * 40}>
                      <a
                        href={`/series/${s.id}`}
                        class="block border border-line bg-paper-elevated px-4 py-4 no-underline transition hover:border-brand/40"
                      >
                        <span class="font-medium text-ink">{s.data.title}</span>
                        <span class="mt-1 block text-sm text-mist-muted">
                          {s.data.description}
                        </span>
                      </a>
                    </Reveal>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <PostList posts={posts} empty="此主題尚無文章。" />
        </section>
      </>
    )
  }
</BaseLayout>
