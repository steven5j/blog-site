---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/Reveal.astro';
import {
  isTopic,
  postPermalink,
  TOPIC_DESCRIPTIONS,
  TOPIC_LABELS,
  TOPICS,
} from '@/utils/permalinks';

export function getStaticPaths() {
  return TOPICS.map((topic) => ({ params: { topic } }));
}

const { topic: topicParam } = Astro.params;
if (!topicParam || !isTopic(topicParam)) {
  return Astro.redirect('/blog');
}
const topic = topicParam;

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.topic === topic)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const seriesList = (await getCollection('series'))
  .filter((s) => s.data.topic === topic)
  .sort((a, b) => a.data.order - b.data.order);

const dateFmt = new Intl.DateTimeFormat('zh-TW', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title={TOPIC_LABELS[topic]}
  description={TOPIC_DESCRIPTIONS[topic]}
>
  <div class="page-banner">
    <div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8">
      <p class="text-xs tracking-[0.25em] text-white/60 uppercase">主題</p>
      <h1 class="font-display mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
        {TOPIC_LABELS[topic]}
      </h1>
      <p class="mt-3 max-w-xl text-white/75">{TOPIC_DESCRIPTIONS[topic]}</p>
    </div>
  </div>

  <section class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    {
      seriesList.length > 0 && (
        <div class="mb-14">
          <Reveal>
            <h2 class="font-display text-xl font-semibold text-ink">相關系列</h2>
          </Reveal>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {seriesList.map((s, i) => (
              <li>
                <Reveal delay={i * 40}>
                  <a
                    href={`/series/${s.id}`}
                    class="block border border-line bg-paper-elevated px-4 py-4 no-underline transition hover:border-brand/40"
                  >
                    <span class="font-medium text-ink">{s.data.title}</span>
                    <span class="mt-1 block text-sm text-mist-muted">
                      {s.data.description}
                    </span>
                  </a>
                </Reveal>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <ul class="divide-y divide-line">
      {
        posts.length === 0 ? (
          <li class="py-8 text-mist-muted">此主題尚無文章。</li>
        ) : (
          posts.map((post, i) => (
            <li>
              <Reveal delay={i * 50}>
                <a
                  href={postPermalink(post.data.pubDate, post.id)}
                  class="group block py-7 no-underline"
                >
                  <time
                    class="text-sm text-mist-muted"
                    datetime={post.data.pubDate.toISOString()}
                  >
                    {dateFmt.format(post.data.pubDate)}
                  </time>
                  <h2 class="font-display mt-2 text-2xl font-semibold text-ink transition group-hover:text-brand">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-mist-muted">{post.data.description}</p>
                </a>
              </Reveal>
            </li>
          ))
        )
      }
    </ul>
  </section>
</BaseLayout>
