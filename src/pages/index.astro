---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/Reveal.astro';
import { postPermalink, TOPIC_LABELS } from '@/utils/permalinks';

const latestPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const allSeries = (await getCollection('series')).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Soft featured series under the software pillar */
const featuredSeriesIds = [
  'architecture',
  'javascript',
  'react',
  'csharp',
  'sql',
  'portfolio',
];

const seriesCovers: Record<string, string> = {
  architecture: '/images/wp/architecture.jpg',
  javascript: '/images/wp/javascript.jpg',
  react: '/images/wp/react.jpg',
  frontend: '/images/wp/frontend.jpg',
  csharp: '/images/wp/csharp.jpg',
  python: '/images/wp/study-notes.jpg',
  sql: '/images/wp/rdbms.jpg',
  android: '/images/wp/android.jpg',
  mis: '/images/wp/mis.jpg',
  portfolio: '/images/wp/project.jpg',
  'real-estate': '/images/wp/social-life.jpg',
};

const pillars = [
  {
    label: '程式',
    href: '/topics/software',
    description: '軟體工程筆記、系列合集與技術發展紀錄。',
    image: '/images/wp/architecture.jpg',
    tags: ['系列', '作品', '筆記'],
  },
  {
    label: '商業經驗',
    href: '/topics/business',
    description:
      '各產業經銷、代理、顧問與現場經營紀錄，並涵蓋投資理財與房地產操作。',
    image: '/images/wp/business-hero.jpg',
    tags: ['商業經驗', '產業實務', '投資', '房地產'],
  },
  {
    label: '生活',
    href: '/topics/life',
    description: '聚會、社團、學習與生活體驗分享。',
    image: '/images/wp/life-hero.jpg',
    tags: ['聚會', '學習', '體驗'],
  },
] as const;

const dateFmt = new Intl.DateTimeFormat('zh-TW', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const featuredSeries = featuredSeriesIds
  .map((id) => allSeries.find((s) => s.id === id))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
---

<BaseLayout transparentHeader>
  <!-- Hero -->
  <section
    class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-ink bg-cover bg-center text-white"
    style="background-image: linear-gradient(rgb(0 0 0 / 0.45), rgb(0 0 0 / 0.5)), url('/images/wp/hero.jpg')"
  >
    <div
      class="relative z-10 mx-auto w-full max-w-site px-5 py-28 text-center sm:px-6 lg:px-8"
      data-reveal
    >
      <h1
        class="mx-auto max-w-full font-sans text-[clamp(2rem,9.5vw,6rem)] leading-none font-semibold tracking-tight text-white max-md:px-1 md:whitespace-nowrap"
      >
        -「STEVEN-朱玄」-
      </h1>
      <p
        class="mt-8 text-sm font-medium tracking-[0.35em] text-white/90 uppercase sm:mt-10 sm:text-base"
      >
        程式 · 商業經驗 · 生活
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3 sm:mt-12">
        <a
          href="#paths"
          class="inline-block border border-white/70 bg-white px-8 py-3 text-xs font-semibold tracking-[0.25em] text-ink no-underline uppercase transition hover:bg-transparent hover:text-white"
        >
          開始閱讀
        </a>
        <a
          href="/about"
          class="inline-block border border-white/70 px-8 py-3 text-xs font-semibold tracking-[0.25em] text-white no-underline uppercase transition hover:bg-white hover:text-ink"
        >
          關於我
        </a>
      </div>
    </div>
  </section>

  <!-- Content paths -->
  <section id="paths" class="scroll-mt-20 bg-paper-elevated">
    <div class="mx-auto max-w-site px-5 py-20 sm:px-6 lg:px-8">
      <Reveal>
        <p class="text-xs font-semibold tracking-[0.3em] text-brand uppercase">
          內容主線
        </p>
        <h2 class="font-display mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl">
          從這裡開始
        </h2>
        <p class="mt-4 max-w-2xl text-mist-muted">
          三條主線對應站上主題：選一條進入 Hub，再用分類錨點或系列往下讀。
        </p>
      </Reveal>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          pillars.map((pillar, i) => (
            <li>
              <Reveal delay={i * 60}>
                <a
                  href={pillar.href}
                  class="group flex h-full flex-col overflow-hidden border border-line bg-paper no-underline transition hover:border-brand/40 hover:shadow-md"
                >
                  <div
                    class="aspect-[16/10] bg-cover bg-center transition duration-500 group-hover:scale-[1.03]"
                    style={`background-image: url('${pillar.image}')`}
                    role="img"
                    aria-hidden="true"
                  />
                  <div class="flex flex-1 flex-col p-5">
                    <h3 class="font-display text-xl font-semibold text-ink transition group-hover:text-brand">
                      {pillar.label}
                    </h3>
                    <p class="mt-2 flex-1 text-sm text-mist-muted">
                      {pillar.description}
                    </p>
                    <p class="mt-3 text-xs tracking-wide text-mist-muted">
                      {pillar.tags.join(' · ')}
                    </p>
                    <span class="mt-4 text-xs font-semibold tracking-wider text-brand uppercase">
                      進入 →
                    </span>
                  </div>
                </a>
              </Reveal>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="bg-paper">
    <div class="mx-auto max-w-site px-5 py-20 sm:px-6 lg:px-8">
      <Reveal>
        <p class="text-xs font-semibold tracking-[0.3em] text-brand uppercase">
          最新文章
        </p>
        <h2 class="font-display mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl">
          Latest Posts
        </h2>
        <p class="mt-4 max-w-2xl text-mist-muted">
          依時間排列的近期文章；完整清單請至文章頁。
        </p>
      </Reveal>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 xl:gap-8">
        {
          latestPosts.map((post, i) => (
            <li>
              <Reveal delay={i * 60}>
                <a
                  href={postPermalink(post.data.pubDate, post.id)}
                  class="group block border border-line bg-paper-elevated p-6 no-underline transition hover:border-brand/40 hover:shadow-sm"
                >
                  <div class="flex items-center gap-2 text-xs tracking-wide text-mist-muted uppercase">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {dateFmt.format(post.data.pubDate)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{TOPIC_LABELS[post.data.topic]}</span>
                  </div>
                  <h3 class="font-display mt-3 text-xl font-semibold text-ink transition group-hover:text-brand">
                    {post.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm text-mist-muted">
                    {post.data.description}
                  </p>
                  <span class="mt-4 inline-block text-xs font-semibold tracking-wider text-brand uppercase">
                    閱讀 →
                  </span>
                </a>
              </Reveal>
            </li>
          ))
        }
      </ul>

      <Reveal class="mt-10 text-center">
        <a
          href="/blog"
          class="inline-block border border-ink px-8 py-3 text-xs font-semibold tracking-[0.2em] text-ink no-underline uppercase transition hover:bg-ink hover:text-white"
        >
          全部文章
        </a>
      </Reveal>
    </div>
  </section>

  <!-- Projects -->
  <section
    class="relative bg-cover bg-center text-white"
    style="background-image: linear-gradient(rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.78)), url('/images/wp/project.jpg')"
  >
    <div class="mx-auto max-w-site px-5 py-24 sm:px-6 lg:px-8">
      <Reveal>
        <p class="text-xs font-semibold tracking-[0.3em] text-white/70 uppercase">
          作品
        </p>
        <h2 class="font-display mt-3 max-w-xl text-3xl font-bold tracking-tight sm:text-4xl">
          專案成就與證照
        </h2>
        <p class="mt-5 max-w-lg text-white/80">
          職涯中經手、發展並完成的開發專案與認證。部分內容屬公司機密，僅公開可分享資訊。
        </p>
        <a
          href="/projects"
          class="mt-10 inline-block border border-white/80 px-8 py-3 text-xs font-semibold tracking-[0.2em] text-white no-underline uppercase transition hover:bg-white hover:text-ink"
        >
          查看作品
        </a>
      </Reveal>
    </div>
  </section>

  <!-- Featured series (software pillar) -->
  <section
    class="relative bg-cover bg-center"
    style="background-image: linear-gradient(rgb(244 244 244 / 0.94), rgb(244 244 244 / 0.96)), url('/images/wp/study-notes.jpg')"
  >
    <div class="mx-auto max-w-site px-5 py-20 sm:px-6 lg:px-8">
      <Reveal>
        <p class="text-xs font-semibold tracking-[0.3em] text-brand uppercase">
          系列精選
        </p>
        <h2 class="font-display mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl">
          精選系列
        </h2>
        <p class="mt-3 max-w-2xl text-mist-muted">
          依主題整理的文章合集；完整目錄請至系列頁。
        </p>
      </Reveal>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredSeries.map((s, i) => {
            const cover = seriesCovers[s.id] || '/images/wp/study-notes.jpg';
            return (
              <li>
                <Reveal delay={i * 50}>
                  <a
                    href={`/series/${s.id}`}
                    class="group block overflow-hidden border border-line bg-paper-elevated no-underline transition hover:border-brand/40 hover:shadow-md"
                  >
                    <div
                      class="aspect-[16/10] bg-cover bg-center transition duration-500 group-hover:scale-[1.03]"
                      style={`background-image: url('${cover}')`}
                      role="img"
                      aria-label={s.data.title}
                    />
                    <div class="p-5">
                      <h3 class="font-display text-lg font-semibold text-ink transition group-hover:text-brand">
                        {s.data.title}
                      </h3>
                      <p class="mt-2 line-clamp-2 text-sm text-mist-muted">
                        {s.data.description}
                      </p>
                      <span class="mt-4 inline-block text-xs font-semibold tracking-wider text-brand uppercase">
                        進入系列 →
                      </span>
                    </div>
                  </a>
                </Reveal>
              </li>
            );
          })
        }
      </ul>

      <Reveal class="mt-12 text-center">
        <a
          href="/series"
          class="inline-block border border-ink px-8 py-3 text-xs font-semibold tracking-[0.2em] text-ink no-underline uppercase transition hover:bg-ink hover:text-white"
        >
          全部系列
        </a>
      </Reveal>
    </div>
  </section>
</BaseLayout>
