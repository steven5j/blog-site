---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/Reveal.astro';
import LottiePlayer from '@/components/islands/LottiePlayer';
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_70%_40%,rgb(61_184_168_/_0.2),transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="mx-auto grid min-h-[calc(100vh-5.5rem)] max-w-5xl items-center gap-10 px-6 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:py-0"
    >
      <div>
        <Reveal>
          <p class="mb-4 text-sm font-medium tracking-[0.2em] text-teal uppercase">
            Personal Blog
          </p>
          <h1
            class="font-display text-balance text-5xl font-semibold tracking-tight text-white sm:text-6xl lg:text-7xl"
          >
            Steven J. Hu
          </h1>
          <p class="mt-6 max-w-md text-lg leading-relaxed text-mist-muted">
            寫軟體、想產品、記旅途。這裡是我的繁中筆記與實驗場。
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="/blog"
              class="inline-flex items-center rounded-md bg-teal px-5 py-2.5 text-sm font-medium text-ink no-underline transition hover:bg-glow"
            >
              閱讀文章
            </a>
            <a
              href="/showcase"
              class="inline-flex items-center rounded-md border border-white/15 px-5 py-2.5 text-sm font-medium text-mist no-underline transition hover:border-teal/50 hover:text-teal"
            >
              看旗艦頁
            </a>
          </div>
        </Reveal>
      </div>
      <Reveal class="relative flex justify-center lg:justify-end" delay={120}>
        <div
          class="relative aspect-square w-full max-w-md overflow-hidden rounded-full bg-ink-elevated/60 ring-1 ring-white/10"
        >
          <div
            class="absolute inset-0 bg-[conic-gradient(from_210deg,rgb(61_184_168_/_0.25),transparent_40%,rgb(94_234_212_/_0.12),transparent_75%)]"
            aria-hidden="true"
          >
          </div>
          <LottiePlayer
            client:visible
            src="/lottie/orbit.json"
            className="relative z-10 h-full w-full p-8"
            loop={true}
            autoplay={true}
          />
        </div>
      </Reveal>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <Reveal>
      <h2 class="font-display text-2xl font-semibold text-white">最近在想什麼</h2>
      <p class="mt-3 max-w-2xl text-mist-muted">
        從靜態站架構到動畫 islands，把複雜互動關在少數頁面，其餘保持極致輕量。
      </p>
    </Reveal>
  </section>
</BaseLayout>
