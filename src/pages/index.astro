---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/Reveal.astro';
import { postPermalink, TOPIC_LABELS } from '@/utils/permalinks';

const latestPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const allSeries = (await getCollection('series')).sort(
  (a, b) => a.data.order - b.data.order,
);

const seriesCovers: Record<string, string> = {
  architecture: '/images/wp/architecture.jpg',
  javascript: '/images/wp/javascript.jpg',
  react: '/images/wp/react.jpg',
  frontend: '/images/wp/frontend.jpg',
  csharp: '/images/wp/frontend.jpg',
  python: '/images/wp/study-notes.jpg',
  sql: '/images/wp/study-notes.jpg',
  android: '/images/wp/study-notes.jpg',
  mis: '/images/wp/study-notes.jpg',
  portfolio: '/images/wp/project.jpg',
  'real-estate': '/images/wp/social-life.jpg',
};

const studyGroups = [
  {
    title: 'Architecture',
    ids: ['architecture'],
  },
  {
    title: 'Front End 前端',
    ids: ['javascript', 'react', 'frontend'],
  },
  {
    title: 'Back End 後端',
    ids: ['csharp', 'python'],
  },
  {
    title: 'Database 資料庫',
    ids: ['sql'],
  },
  {
    title: 'Tools / DevOps / MIS',
    ids: ['android', 'mis'],
  },
];

const dateFmt = new Intl.DateTimeFormat('zh-TW', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

function seriesById(id: string) {
  return allSeries.find((s) => s.id === id);
}
---

<BaseLayout transparentHeader>
  <!-- Hero — full-bleed like WP -->
  <section
    class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-ink bg-cover bg-center text-white"
    style="background-image: linear-gradient(rgb(0 0 0 / 0.45), rgb(0 0 0 / 0.5)), url('/images/wp/hero.jpg')"
  >
    <div class="relative z-10 px-6 py-28 text-center" data-reveal>
      <p
        class="font-display text-[clamp(2.75rem,8vw,5.5rem)] leading-[1.05] font-extrabold tracking-tight text-white"
      >
        <span class="inline-block">-「</span>
        <span class="inline-block">STEVEN</span>
        <span class="mx-1 inline-block text-white/80">-</span>
      </p>
      <p
        class="font-display mt-1 text-[clamp(2.75rem,8vw,5.5rem)] leading-[1.05] font-extrabold tracking-tight text-white"
      >
        朱玄
        <span class="inline-block">」-</span>
      </p>
      <p
        class="mt-10 text-sm font-medium tracking-[0.35em] text-white/90 uppercase sm:text-base"
      >
        理財 / 程式 / 行銷 / 房產
      </p>
      <a
        href="/about"
        class="mt-12 inline-block border border-white/70 px-8 py-3 text-xs font-semibold tracking-[0.25em] text-white no-underline uppercase transition hover:bg-white hover:text-ink"
      >
        ABOUT ME
      </a>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="bg-paper-elevated">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <Reveal>
        <p class="text-xs font-semibold tracking-[0.3em] text-brand uppercase">
          From live Blog
        </p>
        <h2 class="font-display mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl">
          Latest Posts
        </h2>
        <p class="mt-4 max-w-2xl text-mist-muted">
          近期最新的生活紀錄、部落格、軟體工程履歷、房地產操作紀錄、專案作品、講座心得…等
        </p>
      </Reveal>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          latestPosts.map((post, i) => (
            <li>
              <Reveal delay={i * 60}>
                <a
                  href={postPermalink(post.data.pubDate, post.id)}
                  class="group block border border-line bg-paper p-6 no-underline transition hover:border-brand/40 hover:shadow-sm"
                >
                  <div class="flex items-center gap-2 text-xs tracking-wide text-mist-muted uppercase">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {dateFmt.format(post.data.pubDate)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{TOPIC_LABELS[post.data.topic]}</span>
                  </div>
                  <h3 class="font-display mt-3 text-xl font-semibold text-ink transition group-hover:text-brand">
                    {post.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm text-mist-muted">
                    {post.data.description}
                  </p>
                  <span class="mt-4 inline-block text-xs font-semibold tracking-wider text-brand uppercase">
                    點擊查看 →
                  </span>
                </a>
              </Reveal>
            </li>
          ))
        }
      </ul>

      <Reveal class="mt-10 text-center">
        <a
          href="/blog"
          class="inline-block border border-ink px-8 py-3 text-xs font-semibold tracking-[0.2em] text-ink no-underline uppercase transition hover:bg-ink hover:text-white"
        >
          全部文章
        </a>
      </Reveal>
    </div>
  </section>

  <!-- Project & Certification -->
  <section
    class="relative bg-cover bg-center text-white"
    style="background-image: linear-gradient(rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.78)), url('/images/wp/project.jpg')"
  >
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
      <Reveal>
        <h2 class="font-display max-w-xl text-3xl font-bold tracking-tight sm:text-4xl">
          [Project And Certification]
          <span class="mt-2 block">專案成就與證照</span>
        </h2>
        <p class="mt-5 max-w-lg text-white/80">
          於職涯中經手過、發展過並完成的開發專案！
        </p>
        <p class="mt-2 text-sm text-white/55">
          註：專案內容多屬公司機密，僅截取重要資訊
        </p>
        <a
          href="/projects"
          class="mt-10 inline-block border border-white/80 px-8 py-3 text-xs font-semibold tracking-[0.2em] text-white no-underline uppercase transition hover:bg-white hover:text-ink"
        >
          點擊查看
        </a>
      </Reveal>
    </div>
  </section>

  <!-- Study Notes -->
  <section
    class="relative bg-cover bg-center"
    style="background-image: linear-gradient(rgb(244 244 244 / 0.94), rgb(244 244 244 / 0.96)), url('/images/wp/study-notes.jpg')"
  >
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <Reveal>
        <h2 class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
          Study Notes
        </h2>
        <p class="mt-3 text-mist-muted">操作範例、學習筆記、維運紀錄。</p>
      </Reveal>

      <div class="mt-14 space-y-14">
        {
          studyGroups.map((group, gi) => (
            <div>
              <Reveal delay={gi * 40}>
                <h3 class="font-display border-b border-line pb-3 text-xl font-semibold text-ink">
                  {group.title}
                </h3>
              </Reveal>
              <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {group.ids.map((id, i) => {
                  const s = seriesById(id);
                  if (!s) return null;
                  const cover = seriesCovers[id] || '/images/wp/study-notes.jpg';
                  return (
                    <li>
                      <Reveal delay={gi * 40 + i * 50}>
                        <a
                          href={`/series/${s.id}`}
                          class="group block overflow-hidden border border-line bg-paper-elevated no-underline transition hover:border-brand/40 hover:shadow-md"
                        >
                          <div
                            class="aspect-[16/10] bg-cover bg-center transition duration-500 group-hover:scale-[1.03]"
                            style={`background-image: url('${cover}')`}
                            role="img"
                            aria-label={s.data.title}
                          />
                          <div class="p-5">
                            <h4 class="font-display text-lg font-semibold text-ink transition group-hover:text-brand">
                              {s.data.title}
                            </h4>
                            <p class="mt-2 line-clamp-2 text-sm text-mist-muted">
                              {s.data.description}
                            </p>
                            <span class="mt-4 inline-block text-xs font-semibold tracking-wider text-brand uppercase">
                              點擊查看 →
                            </span>
                          </div>
                        </a>
                      </Reveal>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>

      <Reveal class="mt-12 text-center">
        <a
          href="/series"
          class="inline-block border border-ink px-8 py-3 text-xs font-semibold tracking-[0.2em] text-ink no-underline uppercase transition hover:bg-ink hover:text-white"
        >
          全部系列
        </a>
      </Reveal>
    </div>
  </section>

  <!-- Social Life -->
  <section
    class="relative bg-cover bg-center text-white"
    style="background-image: linear-gradient(rgb(0 0 0 / 0.7), rgb(0 0 0 / 0.75)), url('/images/wp/social-life.jpg')"
  >
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-end">
        <Reveal>
          <p class="text-xs font-semibold tracking-[0.3em] text-white/70 uppercase">
            行銷 / 程式 / 理財 / 房產
          </p>
          <h2 class="font-display mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
            SOCIAL LIFE
          </h2>
          <h3 class="font-display mt-8 text-2xl font-semibold">Life of Ideas</h3>
          <p class="mt-4 max-w-md leading-relaxed text-white/80">
            後續網站會整合更多個人資源。我是一個整合多工型的人，多元興趣與開放的態度讓我在各領域上不會退卻，擅長從 0 到
            1 的事業發展與新項目建置——在思考與行動中創造價值。
          </p>
        </Reveal>
        <Reveal delay={100} class="flex flex-wrap gap-3 lg:justify-end">
          <a
            href="/topics/life"
            class="border border-white/70 px-6 py-3 text-xs font-semibold tracking-[0.2em] text-white no-underline uppercase transition hover:bg-white hover:text-ink"
          >
            生活心得
          </a>
          <a
            href="/topics/business"
            class="border border-white/70 px-6 py-3 text-xs font-semibold tracking-[0.2em] text-white no-underline uppercase transition hover:bg-white hover:text-ink"
          >
            產業與商業
          </a>
        </Reveal>
      </div>
    </div>
  </section>
</BaseLayout>
