---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/Reveal.astro';
import CertBadge from '@/components/CertBadge.astro';
import ProjectFeature from '@/components/ProjectFeature.astro';

const items = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const projects = items.filter((i) => i.data.type === 'project');
const certs = items.filter((i) => i.data.type === 'cert');
---

<BaseLayout
  title="專案與證照"
  description="職涯專案、Side Project 與證照成就摘要。"
>
  <div
    class="page-banner min-h-[15rem] sm:min-h-[16.5rem]"
    style="background-image: url('/images/wp/project-achievement.jpg')"
  >
    <div class="mx-auto w-full max-w-site px-5 py-16 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold tracking-[0.22em] text-white/70 uppercase">
        Portfolio
      </p>
      <h1 class="mt-2 font-display text-4xl font-bold tracking-tight sm:text-5xl">
        Project And Certification
      </h1>
      <p class="mt-3 max-w-2xl text-white/75">
        於職涯中經手、發展並完成的開發專案與證照。部分內容屬公司機密，僅公開可分享資訊。
      </p>
    </div>
  </div>

  <!-- Certification Profile -->
  <section class="border-b border-line bg-paper-elevated">
    <div class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <Reveal>
        <p class="text-xs font-semibold tracking-[0.2em] text-brand uppercase">
          Certification Profile
        </p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink sm:text-3xl">
          個人證照
        </h2>
        <p class="mt-3 max-w-2xl text-mist-muted">
          雲端與架構相關認證；徽章可至 Credly 驗證，標題連至考試心得。
        </p>
      </Reveal>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          certs.map((item, i) => (
            <CertBadge
              title={item.data.title}
              summary={item.data.summary}
              year={item.data.year}
              image={item.data.image}
              link={item.data.link}
              credlyUrl={item.data.credlyUrl}
              delay={i * 80}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Project Achievement -->
  <section class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
    <Reveal>
      <p class="text-xs font-semibold tracking-[0.2em] text-brand uppercase">
        Project Achievement
      </p>
      <h2 class="mt-2 font-display text-2xl font-semibold text-ink sm:text-3xl">
        專案成就
      </h2>
      <p class="mt-3 max-w-2xl text-mist-muted">
        職涯與 Side Project 摘要；點擊可進入完整專案說明。
      </p>
    </Reveal>

    <div class="mt-4">
      {
        projects.map((item, i) => (
          <ProjectFeature
            title={item.data.title}
            summary={item.data.summary}
            year={item.data.year}
            image={item.data.image}
            link={item.data.link}
            role={item.data.role}
            outcomes={item.data.outcomes}
            tech={item.data.tech}
            ctaLabel={item.data.ctaLabel}
            reverse={i % 2 === 1}
            delay={Math.min(i * 60, 240)}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
