---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/Reveal.astro';
import {
  postPermalink,
  TOPIC_LABELS,
  type Topic,
} from '@/utils/permalinks';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFmt = new Intl.DateTimeFormat('zh-TW', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title="文章" description="Steven玄 的繁中部落格文章列表。">
  <div class="page-banner">
    <div class="mx-auto w-full max-w-site px-5 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold tracking-[0.25em] text-white/60 uppercase">
        文章
      </p>
      <h1 class="font-display mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
        全部文章
      </h1>
      <p class="mt-3 text-white/75">
        依時間排列。也可從主題進到各領域 Hub。
      </p>
    </div>
  </div>

  <section class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
    <Reveal>
      <p class="mb-3 text-xs font-semibold tracking-[0.2em] text-mist-muted uppercase">
        依主題篩選
      </p>
      <ul class="flex flex-wrap gap-2 text-sm">
        {
          (Object.keys(TOPIC_LABELS) as Topic[]).map((topic) => (
            <li>
              <a
                href={`/topics/${topic}`}
                class="border border-line bg-paper-elevated px-3 py-1.5 text-mist-muted no-underline transition hover:border-brand hover:text-brand"
              >
                {TOPIC_LABELS[topic]}
              </a>
            </li>
          ))
        }
      </ul>
    </Reveal>

    <ul class="mt-12 divide-y divide-line">
      {
        posts.map((post, i) => (
          <li>
            <Reveal delay={i * 50}>
              <a
                href={postPermalink(post.data.pubDate, post.id)}
                class="group block py-7 no-underline transition"
              >
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-mist-muted">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFmt.format(post.data.pubDate)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{TOPIC_LABELS[post.data.topic]}</span>
                </div>
                <h2 class="font-display mt-2 text-2xl font-semibold text-ink transition group-hover:text-brand">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-mist-muted">{post.data.description}</p>
              </a>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
