---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/Reveal.astro';
import { TOPIC_LABELS } from '@/utils/permalinks';

const seriesList = (await getCollection('series')).sort(
  (a, b) => a.data.order - b.data.order,
);

const seriesCovers: Record<string, string> = {
  architecture: '/images/wp/architecture.jpg',
  javascript: '/images/wp/javascript.jpg',
  react: '/images/wp/react.jpg',
  frontend: '/images/wp/frontend.jpg',
  csharp: '/images/wp/csharp.jpg',
  sql: '/images/wp/rdbms.jpg',
  android: '/images/wp/android.jpg',
  mis: '/images/wp/mis.jpg',
  portfolio: '/images/wp/project.jpg',
  'real-estate': '/images/wp/social-life.jpg',
};
---

<BaseLayout
  title="學習系列"
  description="操作範例、學習筆記與維運紀錄的系列總覽。"
>
  <div
    class="page-banner"
    style="background-image: url('/images/wp/study-notes.jpg')"
  >
    <div class="mx-auto w-full max-w-site px-5 py-16 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">
        Study Notes
      </h1>
      <p class="mt-3 text-white/75">操作範例、學習筆記、維運紀錄。</p>
    </div>
  </div>

  <section class="mx-auto max-w-site px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        seriesList.map((s, i) => (
          <li>
            <Reveal delay={i * 40}>
              <a
                href={`/series/${s.id}`}
                class="group block overflow-hidden border border-line bg-paper-elevated no-underline transition hover:border-brand/40 hover:shadow-md"
              >
                <div
                  class="aspect-[16/10] bg-ink bg-cover bg-center"
                  style={`background-image: url('${seriesCovers[s.id] || '/images/wp/study-notes.jpg'}')`}
                />
                <div class="p-5">
                  <p class="text-xs tracking-wide text-brand uppercase">
                    {TOPIC_LABELS[s.data.topic]}
                  </p>
                  <h2 class="font-display mt-2 text-xl font-semibold text-ink transition group-hover:text-brand">
                    {s.data.title}
                  </h2>
                  <p class="mt-2 text-sm text-mist-muted">{s.data.description}</p>
                </div>
              </a>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
