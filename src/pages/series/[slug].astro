---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import { TOPIC_LABELS } from '@/utils/permalinks';

export async function getStaticPaths() {
  const seriesList = await getCollection('series');
  return seriesList.map((entry) => ({
    params: { slug: entry.id },
    props: { seriesId: entry.id },
  }));
}

const { seriesId } = Astro.props;
const entry = await getEntry('series', seriesId);
if (!entry) {
  return Astro.redirect('/series');
}

const { Content } = await render(entry);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.series === seriesId)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const covers: Record<string, string> = {
  architecture: '/images/wp/architecture.jpg',
  javascript: '/images/wp/javascript.jpg',
  react: '/images/wp/react.jpg',
  frontend: '/images/wp/frontend.jpg',
  portfolio: '/images/wp/project.jpg',
  'real-estate': '/images/wp/social-life.jpg',
};
const banner = covers[seriesId] || '/images/wp/study-notes.jpg';
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="page-banner" style={`background-image: url('${banner}')`}>
    <div class="mx-auto w-full max-w-site px-5 py-16 sm:px-6 lg:px-8">
      <p class="text-sm text-white/70">
        <a href="/series" class="no-underline hover:text-white">系列</a>
        <span class="mx-2 opacity-50">/</span>
        <a
          href={`/topics/${entry.data.topic}`}
          class="no-underline hover:text-white"
        >
          {TOPIC_LABELS[entry.data.topic]}
        </a>
      </p>
      <h1
        class="font-display mt-3 text-4xl font-bold tracking-tight sm:text-5xl"
        data-pagefind-meta="title"
        data-pagefind-weight="10"
      >
        {entry.data.title}
      </h1>
      {
        entry.data.intro && (
          <p class="mt-4 max-w-3xl text-lg text-white/80" data-pagefind-body>
            {entry.data.intro}
          </p>
        )
      }
    </div>
  </div>

  <section class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
    <span hidden data-pagefind-meta="kind:series" data-pagefind-filter="kind:series"></span>
    <span
      hidden
      data-pagefind-meta={`topic:${entry.data.topic}`}
      data-pagefind-filter={`topic:${entry.data.topic}`}
    ></span>
    <div class="prose-blog" data-pagefind-body data-reveal>
      <Content />
    </div>

    <div class="mt-14" data-pagefind-ignore>
      <PostList posts={posts} empty="此系列尚無文章。" />
    </div>
  </section>
</BaseLayout>
