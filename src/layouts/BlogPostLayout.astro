---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProtectedContentGate from '@/components/islands/ProtectedContentGate';
import { TOPIC_LABELS, type Topic } from '@/utils/permalinks';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  topic?: Topic;
  series?: string;
  heroImage?: string;
  jsonLd?: Record<string, unknown>[];
  protectedSlug?: string;
  protectedOnly?: boolean;
  protectedInline?: boolean;
  protectedStandaloneUrl?: string;
  protectedPublicUrl?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  topic,
  series,
  heroImage,
  jsonLd,
  protectedSlug,
  protectedOnly = false,
  protectedInline = false,
  protectedStandaloneUrl,
  protectedPublicUrl,
} = Astro.props;

const showFooterGate = protectedSlug && !protectedInline && !protectedOnly;

const dateFmt = new Intl.DateTimeFormat('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  ogImage={heroImage}
  type="article"
  jsonLd={jsonLd}
>
  <article
    class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8"
    {...(!protectedOnly
      ? {
          'data-pagefind-body': true,
          'data-pagefind-meta': 'kind:article',
          'data-pagefind-filter': 'kind:article',
        }
      : {})}
  >
    {
      !protectedOnly && topic && (
        <span hidden data-pagefind-meta={`topic:${topic}`} data-pagefind-filter={`topic:${topic}`} />
      )
    }
    <header class="mb-12 border-b border-line pb-10">
      <p class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-mist-muted">
        <time datetime={pubDate.toISOString()} data-pagefind-meta="date">
          {dateFmt.format(pubDate)}
        </time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>更新於 {dateFmt.format(updatedDate)}</span>
            </>
          )
        }
        {
          topic && (
            <>
              <span aria-hidden="true">·</span>
              <a
                href={`/topics/${topic}`}
                class="text-brand no-underline hover:text-brand-hover"
              >
                {TOPIC_LABELS[topic]}
              </a>
            </>
          )
        }
        {
          series && (
            <>
              <span aria-hidden="true">·</span>
              <a
                href={`/series/${series}`}
                class="text-brand no-underline hover:text-brand-hover"
              >
                {series}
              </a>
            </>
          )
        }
      </p>
      <h1
        class="font-display text-balance text-4xl font-bold tracking-tight text-ink sm:text-5xl"
        data-pagefind-meta="title"
        data-pagefind-weight="10"
      >
        {title}
      </h1>
      {
        !protectedOnly && (
          <p class="mt-5 text-lg text-mist-muted">{description}</p>
        )
      }
      {
        tags.length > 0 && !protectedOnly && (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="標籤">
            {tags.map((tag) => (
              <li class="border border-line bg-paper-elevated px-2.5 py-1 text-xs text-mist-muted">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
      {
        heroImage && !protectedOnly && (
          <figure class="mt-8 overflow-hidden border border-line bg-paper-elevated">
            <img
              src={heroImage}
              alt={title}
              width="1920"
              height="1080"
              class="block h-auto w-full"
            />
          </figure>
        )
      }
    </header>

    {
      protectedOnly && protectedSlug ? (
        <div class="prose-blog" data-pagefind-ignore>
          <ProtectedContentGate
            client:load
            slug={protectedSlug}
            mode="page"
            publicPostUrl={protectedPublicUrl}
          />
        </div>
      ) : (
        <div class="prose-blog">
          <slot />
        </div>
      )
    }

    {
      showFooterGate && (
        <div class="mt-16 border-t border-line pt-12" data-pagefind-ignore>
          <ProtectedContentGate
            client:load
            slug={protectedSlug!}
            mode="embed"
            standaloneUrl={protectedStandaloneUrl}
          />
        </div>
      )
    }
  </article>
</BaseLayout>
