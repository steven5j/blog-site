<style>

	/* 在這裡撰寫網站專屬 CSS 程式碼 */

	.Stevenjhu-FocusText{
		padding: 2px 4px;
   		font-size: 90%;
		color:#c7254e;
		background-color: #f9f2f4;
		border-radius: 4px;
	}
	
	.Stevenjhu-H2{
		padding-left: 20px;
    	padding-top: 5px;
    	padding-bottom: 5px;
    	background-color: #eee;
    	border-left: 5px solid #C13B3B;
    	margin-bottom: 20px;
		
		font-weight: 600;
    	line-height: 1.6em;
	}
	
	

	
</style>
<style>

	/* 在文章內的 標籤樣式更改*/
	.entry-content H2{
		padding-left: 20px;
    	padding-top: 5px;
    	padding-bottom: 5px;
    	border-left: 5px solid #C13B3B;
		border-bottom: 5px solid brown;
    	margin-bottom: 20px;
		font-size:32px;
		font-weight: 600;
    	line-height: 1.6em;
	}
	.entry-content H2::first-letter{
		font-size:48px;
		color:#C13B3B;
		font-weight: 900;
    	line-height: 1.7em;
	}
	
	
	.entry-content H3{
    	padding: 5px 10px 5px 10px;
   	 	width: fit-content;
    	margin-top: 10px;
    	margin-bottom: 20px;
		
		border-right: 5px solid #5686BF;
		border-bottom: 5px solid #5686BF;
		
    	color: black;
		font-size:28px;
		font-weight: 500;
	}
	
	.entry-content H4{
    	font-size: 22px;
    	width: fit-content;
		font-weight: 500;
    	border: 2px solid #666 ;
		padding:0px 5px;
	}
	
	
	/* 下/上一篇 標籤樣式更改*/
	.single nav.post-navigation .nav-previous{
		
	background: #fff;
    padding: 15px;
    font-weight: 600;
	border:3px solid #eee;
    border-radius: 10px;
    transition-duration: .3s;
    transition-property: transform box-shadow;
    transition-timing-function: ease-out;
	}
	.single nav.post-navigation .nav-previous:hover{
	/*outline: 5px;
    outline-style: dashed;
    outline-offset: revert;*/
    box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.5);
    transform: translateX(-5px);
	}
	.single nav.post-navigation .nav-next{
	background: #fff;
    padding: 15px;
    font-weight: 600;
	border:3px solid #eee;
    border-radius: 10px;
    transition-duration: .3s;
    transition-property: transform box-shadow;
    transition-timing-function: ease-out;
	}
	.single nav.post-navigation .nav-next:hover{
	/*outline: 5px;
    outline-style: dashed;
    outline-offset: revert;*/
    box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.5);
    transform: translateX(5px);
	}
	
	
	
	/* 作者區塊 標籤樣式更改*/
	#author-bio-inner{
		border: 5px solid #eee;
    padding: 15px;
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    -ms-box-sizing: border-box;
    box-sizing: border-box;
    width: 100%;
    clear: both;
    overflow: hidden;
	}
	#author-bio-inner .author-bio-avatar{
	float: left;
    padding: 15px;
	}
	#author-bio-inner .author-bio-avatar img{
	max-width: 100px;
    height: auto;
    border-radius: 0;
	}
	author-bio .author-bio-title {
		display: inline-block;
    font-size: 22px;
    margin: 0 0 10px;
    text-transform: capitalize;
	}
	#author-bio .author-bio-content {
    	display: block;
	}
</style>
<style>

	/* 在文章內的 標籤樣式更改*/
	.right-sidebar-inner.sidebar-box {
	border-radius: 5px;
	}
	

	
</style>
